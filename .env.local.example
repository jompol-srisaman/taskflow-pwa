# Google OAuth2 credentials (เอาจาก Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_client_secret

# Refresh Token (ได้จากรัน: node scripts/get-token.js)
GOOGLE_REFRESH_TOKEN=your_refresh_token_here

# Spreadsheet ID (จาก URL: /spreadsheets/d/XXXX/edit)
GOOGLE_SHEETS_ID=your_spreadsheet_id_here

# Calendar ID (ใช้ primary ได้เลย หรือใส่ email ของ calendar)
GOOGLE_CALENDAR_ID=primary
